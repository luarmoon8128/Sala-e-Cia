    {
      "name": "Login",
      "item": [
        {
          "name": "OK → 200 + token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"senha-forte-123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();pm.test('tem token',()=>pm.expect(j.token).to.be.a('string'));pm.collectionVariables.set('token',j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: senha errada → 401 genérico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"errada-errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401',()=>pm.response.to.have.status(401));",
                  "pm.test('mensagem genérica',()=>pm.expect(pm.response.json().erro).to.eql('E-mail ou senha inválidos'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: e-mail inexistente → 401 igual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ninguem@escola.test\",\n  \"senha\": \"errada-errada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: sem campos → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
