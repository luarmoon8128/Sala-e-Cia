{
  "info": {
    "name": "Pátio Escolar — API de autenticação",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode as pastas em ordem. O e-mail de recuperação aparece no terminal do servidor em desenvolvimento (sem SMTP). Para testar o limite de tentativas, repita 'senha errada' 6 vezes: a 6ª retorna 429."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "maria.postman@escola.test"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "codigo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Cadastro",
      "item": [
        {
          "name": "OK → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Souza\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"senha-forte-123\",\n  \"confirmarSenha\": \"senha-forte-123\",\n  \"aceitoPolitica\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: senha curta → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
