# Servidor
PORT=3000
NODE_ENV=development
# Endereço público do site (usado no link do e-mail de recuperação). Em produção: https://...
APP_URL=http://localhost:3000
# Atrás de proxy (Render, Heroku, Nginx)? Deixe 1 em produção. Local: 0.
TRUST_PROXY=0

# Banco de dados (ou use DATABASE_URL=postgres://usuario:senha@host:5432/banco)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patio_escolar
DB_USER=
DB_PASSWORD=

# Autenticação — NUNCA coloque valores reais neste arquivo; o .env de verdade fica fora do Git.
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_COST=12
RESET_TTL_MIN=30
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15

# E-mail (recuperação de senha). Em desenvolvimento, sem SMTP o link aparece no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pátio Escolar <nao-responda@seudominio.com>"
